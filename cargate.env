# cargate configuration — copy to the path CARGATE_ENV_FILE points at
# (default ~/.config/cargate/env) and fill in your values.

# Telegram bot token (alert channel). Get one from @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat ID the alerts go to (your user id — talk to @userinfobot).
CARGATE_CHAT_ID=

# Short device label used in every alert message, e.g. "car".
CARGATE_DEVICE_LABEL=car

# Base directory for logs, pid, location state (default ~/alarm).
CARGATE_ALARM_DIR=~/alarm

# --- capture hook (optional: without a peripheral nothing breaks) ---

# SSH user on the capture peripheral (Termux: your u0_aXXX).
CARGATE_PERIPHERAL_USER=

# SSH port on the peripheral (Termux sshd default: 8022).
CARGATE_PERIPHERAL_PORT=8022

# SSH key used to reach the peripheral.
CARGATE_SSH_KEY=~/.ssh/id_ed25519

# Path to the DHCP leases file the alarm host hands out (NetworkManager
# shared-connection dnsmasq).
CARGATE_LEASES_FILE=/var/lib/NetworkManager/dnsmasq-wlan0.leases

# Capture command run on the peripheral (this repo ships capture.sh).
CARGATE_REMOTE_CAPTURE=bash ~/alarm/bin/capture.sh

# Hostname prefixes (comma-separated) of owner phones that must never be
# mistaken for the capture peripheral when resolving DHCP leases.
CARGATE_OWNER_HOST_PREFIXES=

# --- car AP manager ---

# Your home WiFi SSID. When the alarm phone is its client, the car AP is
# torn down (broadcasting a clone of the home SSID at home hijacks clients).
CARGATE_HOME_SSID=

# NetworkManager connection name of the car AP.
CARGATE_AP_CONNECTION=car-ap

# --- evidence flush ---

# Where pulled capture files land on the alarm host (default ~/captures).
CARGATE_CAPTURE_ROOT=~/captures